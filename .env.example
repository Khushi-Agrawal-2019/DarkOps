# Google Cloud Project Configuration
PROJECT_ID=your-gcp-project-id
REGION=us-central1
BIGQUERY_LOCATION=US
BIGQUERY_DATASET=return_detective
GCS_BUCKET=your-gcp-project-id-rd-photos
PUBSUB_TOPIC=complaints
PUBSUB_SUBSCRIPTION=complaints-sub
FIRESTORE_DATABASE=(default)

# Model IDs (Always read via env vars, never hardcoded)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
IMAGEN_MODEL=imagen-3.0-generate-002
EMBEDDING_MODEL=text-multimodal-embedding-001

# Service URLs
RD_API_URL=http://localhost:8000
RD_RUNNER_URL=http://localhost:8001
RD_WEB_URL=http://localhost:3000

# Integrations
GOOGLE_CHAT_WEBHOOK_URL=
GOOGLE_APPLICATION_CREDENTIALS=

# Local / Mock development mode (set to true to test full agent pipelines locally without billing)
MOCK_MODE=false
USE_ML=true
